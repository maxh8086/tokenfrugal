# TokenFrugal configuration. Copy to .env (cp .env.example .env) and edit.
# Any OpenAI-compatible endpoint works: Ollama (default), LM Studio, vLLM, llama.cpp server, a hosted API.
# Set host AND port here.
TOKENFRUGAL_LLM_URL=http://localhost:11434/v1
TOKENFRUGAL_LLM_API_KEY=ollama

# Local models used by the two worker tiers (see router/tf-roles.yaml). Pull them with: ollama pull <tag>
# Edit tf-roles.yaml `models:` to change them.

# Plan-store retention in days (0 disables pruning)
PLAN_RETENTION_DAYS=30

# Sampling temperature for every local model call (loop, summaries, benchmarks).
# Keep 0.0 so benchmark runs are comparable; the benchmark preflight fails if it is not 0.0.
LOCAL_LLM_TEMPERATURE=0.0

# Optional overrides
# CC_WORKSPACE=/absolute/path/to/your/project
# SYNAPTREE_DIR=/path/to/synaptree-mcp    (default: ../synaptree-mcp)
# SYNAPTREE_PROJECT=tokenfrugal           (default: checkout folder name)
# MCP_ENV_FILE=~/.docker/mcp/mcp.env
